---
import { Picture } from "astro:assets";
import Icon from "../lib/@ui/Icon";
import { getEntry, render } from "astro:content";
import Heading from "../lib/@ui/typography/Heading";
import typography from "../lib/@ui/typography";
import Segments from "./Segments.astro";
import { resolveImage } from "../lib/images";

const home = await getEntry("pages", "index");
if (!home) throw new Error("Missing src/content/pages/index.mdx");
const { Content } = await render(home);
const photo = home.data.about_photo ? resolveImage(home.data.about_photo) : undefined;
---
<div
  class="flex flex-col items-center lg:flex-row gap-6"
>
  {photo && <figure>
    <Picture
      background="white"
      src={photo}
      role="presentation"
      alt=""
      width={400}
      height={400}
      widths={[400, 500, 600, 700, 800, 900, 1000]}
      formats={['avif', 'webp', 'png']}
      sizes="400px"
      class="lg:max-w-sm xl:max-w-md rounded-md overflow-hidden shadow-md"
    />
  </figure>}
  <div class="flex flex-col gap-4">
    <Heading as="h2">
      <Segments segments={home.data.about_heading} />
    </Heading>
    <Content components={typography} />
  </div>
</div>