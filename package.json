{
  "name": "@example/basics",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npx @gogitcms/editor build --out public/admin && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cms:styles": "tailwindcss -c tailwind.config.cjs -i plugins/plugin-mdx/styles/input.css -o plugins/plugin-mdx/components/site.css --minify"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/*.{js,jsx,ts,tsx,json,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@handlewithcare/react-prosemirror": "^3.2.7",
    "@resvg/resvg-js": "^2.2.0",
    "@resvg/resvg-wasm": "^2.2.0",
    "@tabler/icons": "^1.119.0",
    "@types/js-cookie": "^3.0.2",
    "@types/node": "^22.12.0",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "astro": "^7.3.3",
    "autoprefixer": "^10.4.13",
    "htm": "^3.1.1",
    "js-cookie": "^3.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "mime": "^3.0.0",
    "mini-svg-data-uri": "^1.4.4",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.0",
    "react": "^18.2.0",
    "react-aria": "^3.22.0",
    "react-dom": "^18.2.0",
    "react-reconciler": "^0.32.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-mdx-code-meta": "^2.0.0",
    "remark-reading-time": "^2.1.0",
    "satori": "^0.1.1",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.2.4",
    "to-ico": "^1.1.5",
    "web-vitals": "^3.1.1"
  },
  "devDependencies": {
    "@gogitcms/preview-sidecar": "^0.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "prettier": "^2.8.3",
    "prettier-plugin-astro": "^0.7.2"
  },
  "// overrides": "react-reconciler is only loaded by the CMS editor, for plugins/plugin-mdx's @handlewithcare/react-prosemirror, and the editor always resolves React to its own 19.x copy. So it stays the React 19 build, and its react peer is pointed at this site's React 18 (what @astrojs/react renders with) to let npm install the two side by side.",
  "overrides": {
    "react-reconciler": {
      "react": "$react"
    }
  }
}
